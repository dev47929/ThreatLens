		"userdoc": {
			"kind": "user",
			"methods": {
				"anchorChain(string,uint256,bytes32)": {
					"notice": "Create an on-demand anchor for a ThreadLens chain. The chain height must be greater than the previously anchored height for the same chain."
				},
				"getAnchorByHeight(string,uint256)": {
					"notice": "Fetch an anchor using chain ID and chain height."
				},
				"getAnchorById(uint256)": {
					"notice": "Fetch an anchor using its global ID."
				},
				"getAnchorCount()": {
					"notice": "Get the total number of anchors created."
				},
				"getLatestAnchor(string)": {
					"notice": "Fetch the latest anchor for a chain."
				},
				"getLatestChainHeight(string)": {
					"notice": "Get the latest anchored height of a chain."
				},
				"isAnchored(string,uint256)": {
					"notice": "Check whether a specific chain height has been anchored."
				}
			},
