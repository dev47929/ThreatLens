# ==============================================================================
# ThreatLensGo Terminal UI (TUI) - Sample Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your credentials:
#   cp .env.example .env
# ==============================================================================

# --- LLM Provider Settings (Required for Autonomous Security Agent) ---
# Primary: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Target LLM model name
# Examples: google/gemini-3.7-flash, anthropic/claude-3.5-sonnet, nvidia/nemotron-3.5-lightning:free
LLM_MODEL=google/gemini-3.7-flash

# OpenAI-compatible API base URL (defaults to https://openrouter.ai/api/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Optional Alternative Direct LLM Providers ---
# If not using OpenRouter, you can specify direct provider keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Backend Connectivity ---
# URL for ThreatLens cli-backend service (defaults to http://localhost:1234)
THREATLENS_BACKEND_URL=http://localhost:1234
